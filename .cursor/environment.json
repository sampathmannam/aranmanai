{
  "name": "Aranmanai",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "install": "./scripts/cloud-agent-install.sh",
  "start": "./scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "api",
      "command": "./venv/bin/python -m uvicorn aranmanai.api.main:app --host 127.0.0.1 --port 8080"
    },
    {
      "name": "frontend",
      "command": "./venv/bin/python -m streamlit run src/aranmanai/frontend/app.py --server.port 8501 --server.address 127.0.0.1"
    }
  ],
  "ports": [
    {
      "name": "api",
      "port": 8080
    },
    {
      "name": "frontend",
      "port": 8501
    }
  ]
}
