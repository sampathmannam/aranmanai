# Aranmanai — environment template
# Copy to .env and fill in for production. Defaults are dev-friendly.
#
# ALL settings use the ARANMANAI_ prefix (Settings.model_config
# env_prefix="ARANMANAI_"). A bare, unprefixed name here is NOT read for
# most fields -- and for the one list-typed field (CORS_ORIGINS) an
# unprefixed key actively crashes get_settings() (pydantic-settings
# skips JSON-decoding on that fallback path). Every line below is real
# and matches a field in src/aranmanai/config/settings.py -- if you add
# a var that isn't one of these, it will be silently ignored.

# --- App ---
ARANMANAI_APP_NAME=Aranmanai
ARANMANAI_VERSION=0.1.0
ARANMANAI_ENVIRONMENT=development            # development | staging | production
ARANMANAI_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL
ARANMANAI_LOG_FORMAT=json                    # json | text
ARANMANAI_DISTRICT=Vellore

# --- Server ---
ARANMANAI_HOST=127.0.0.1
ARANMANAI_PORT=8080
ARANMANAI_WORKERS=1
ARANMANAI_CORS_ORIGINS=["http://localhost:8501"]

# --- Storage ---
ARANMANAI_DATA_DIR=data
ARANMANAI_DB_PATH=data/aranmanai.db
ARANMANAI_CHROMA_PERSIST_DIR=data/chroma

# --- Security (CHANGE BEFORE PRODUCTION) ---
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# App refuses to start without ARANMANAI_DB_KEY / ARANMANAI_JWT_SECRET
# set to 32+ chars -- there is no working default.
ARANMANAI_DB_KEY=dev-only-change-me-in-prod-7f3a9c2b8e1d4f6a-please-replace
ARANMANAI_JWT_SECRET=dev-only-change-me-in-prod-jwt-c4e8a1d9f2b3-please-replace
ARANMANAI_JWT_ALGORITHM=HS256
ARANMANAI_JWT_EXPIRY_MINUTES=60
ARANMANAI_BCRYPT_ROUNDS=12

# --- Audit log (DPDP §8(3)) ---
ARANMANAI_ENABLE_AUDIT_LOG=true
ARANMANAI_AUDIT_LOG_PATH=data/audit.log

# --- Backup (scripts/backup.py, run daily via cron / Task Scheduler) ---
# ARANMANAI_BACKUP_ENCRYPTION_KEY must also be 32+ chars -- checked by
# the backup script itself, not at API startup (only backup.py needs it).
ARANMANAI_BACKUP_ENCRYPTION_KEY=dev-only-change-me-in-prod-backup-9b4e7c1d5a8f-please-replace
ARANMANAI_BACKUPS_DIR=data/backups
ARANMANAI_BACKUP_SCHEDULE_HOURS=24

# --- AI (local LLM) ---
# Backend: llama_cpp | ollama | mock
ARANMANAI_LLM_BACKEND=mock
# Path to a GGUF model file. Recommended: Phi-3.5-mini-instruct Q4_K_M (~2.2GB)
# Download from: https://huggingface.co/microsoft/Phi-3.5-mini-instruct-q4.gguf
ARANMANAI_LLM_MODEL_PATH=models/llm/qwen-1.5b-instruct/qwen2.5-1.5b-instruct-q4_k_m.gguf
ARANMANAI_LLM_N_CTX=4096
ARANMANAI_LLM_N_THREADS=8
ARANMANAI_LLM_N_GPU_LAYERS=20               # 20-28 safe for 3.8B Q4_K_M on RTX 2050 4GB
ARANMANAI_LLM_TEMPERATURE=0.1
ARANMANAI_LLM_MAX_TOKENS=1024
ARANMANAI_OLLAMA_URL=http://127.0.0.1:11434
ARANMANAI_OLLAMA_MODEL=phi3.5:3.8b-mini-instruct-q4_K_M

# --- Feature flags ---
ARANMANAI_ENABLE_VOICE_INPUT=false
ARANMANAI_ENABLE_TAMIL_UI=true
ARANMANAI_ENABLE_RISK_SCORING=true
ARANMANAI_ENABLE_MOCK_INTEGRATIONS=true

# --- Voice (Whisper local) ---
ARANMANAI_WHISPER_MODEL=small                 # tiny | base | small | medium
ARANMANAI_WHISPER_DEVICE=cpu
ARANMANAI_VAD_THRESHOLD=0.5
ARANMANAI_MAX_AUDIO_SIZE_MB=50

# --- Tamil / multilingual (translation + embeddings) ---
ARANMANAI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ARANMANAI_TRANSLATION_MODEL_ENTA=Helsinki-NLP/opus-mt-en-ta
ARANMANAI_TRANSLATION_MODEL_TAEN=Helsinki-NLP/opus-mt-ta-en
ARANMANAI_TRANSLATION_MODEL_ENHI=Helsinki-NLP/opus-mt-en-hi
ARANMANAI_TRANSLATION_MODEL_HIEN=Helsinki-NLP/opus-mt-hi-en

# --- Mock state-platform integrations ---
# CCTNS/eSakshya/ICJS are always mock in v1 (real integration needs DGP
# sign-off -- see README "Honest trade-offs"). ENABLE_MOCK_INTEGRATIONS
# above is the one real toggle; there is no working per-system mode
# switch (CCTNS_MODE/ESAKSHYA_MODE/ICJS_MODE do not exist as settings).
ARANMANAI_MOCK_CCTNS_DATA_DIR=data/mock_cctns
ARANMANAI_MOCK_ESAKSHYA_DATA_DIR=data/mock_esakshya
ARANMANAI_MOCK_ICJS_DATA_DIR=data/mock_icjs
