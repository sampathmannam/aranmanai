# Aranmanai — environment template
# Copy to .env and fill in for production. Defaults are dev-friendly.

# --- App ---
APP_NAME=Aranmanai
APP_VERSION=0.1.0
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL
CORS_ORIGINS=["http://localhost:8501"]

# --- Storage ---
DATA_DIR=data
DB_PATH=data/aranmanai.db
CHROMA_DIR=data/chroma
MODELS_DIR=models
BACKUPS_DIR=data/backups

# --- Security (CHANGE BEFORE PRODUCTION) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_ENCRYPTION_KEY=dev-only-change-me-in-prod-7f3a9c2b8e1d4f6a
JWT_SECRET=dev-only-change-me-in-prod-jwt-c4e8a1d9f2b3
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
BCRYPT_ROUNDS=12
BACKUP_ENCRYPTION_KEY=dev-only-change-me-in-prod-backup-9b4e7c1d5a8f
BACKUP_SCHEDULE_HOURS=24

# --- AI (local LLM) ---
# Backend: llama-cpp-python | ollama | mock
LLM_BACKEND=mock
# Path to a GGUF model file. Recommended: Phi-3.5-mini-instruct Q4_K_M (~2.2GB)
# Download from: https://huggingface.co/microsoft/Phi-3.5-mini-instruct-q4.gguf
LLM_MODEL_PATH=models/Phi-3.5-mini-instruct-Q4_K_M.gguf
LLM_N_CTX=4096
LLM_N_GPU_LAYERS=20               # 20-28 safe for 3.8B Q4_K_M on RTX 2050 4GB
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- Voice (Whisper local) ---
WHISPER_MODEL=small                 # tiny | base | small | medium
WHISPER_DEVICE=cpu

# --- State-platform integration (mock by default) ---
CCTNS_MODE=mock                    # mock | real
ESAKSHYA_MODE=mock
ICJS_MODE=mock

# --- Pilot / Tenant (single district v1) ---
DISTRICT=Vellore
TENANT_ENABLED=false               # Multi-tenant is v2. v1 is single-district only.
